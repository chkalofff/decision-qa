# Секреты — никогда не коммитить
backend/credentials.json
backend/access_tokens.json

# Python
.venv*/
**/__pycache__/
*.pyc

# macOS
.DS_Store

# Логи и локальное состояние
server/logs/
server/state/
backend/.setup_state.json
backend/presets_user/

# Внешние чекауты (имеют свой .git)
server/sglang/
server/llama.cpp/
server/clef/.venv/

# Модели и кэши
*.gguf

# Сборка релизов
dist/

# сборка cm-бандла
scripts/cm-bundle/node_modules/
scripts/cm-bundle/package-lock.json

# Рабочие документы проектирования — только локально
docs/assistant-v2-concept*.md
docs/TZ_VISUAL_AUTOMATION.md
# docs/evals/ — локальные сценарии/результаты eval'ов; публикуются только
# агрегированные базлайны (baseline-*.md), отчёты экспериментов
# (thinking-experiment-*.md), replay-корпус (corpus/ — синтетические
# сессии, блокирующий гейт тестов v1.2) и его фикстуры (fixtures/ — на них
# ссылаются сессии корпуса через ../fixtures/)
docs/evals/*
!docs/evals/baseline-*.md
!docs/evals/thinking-experiment-*.md
!docs/evals/corpus/
!docs/evals/fixtures/
